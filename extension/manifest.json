{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "3.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_settingsTitle__",
    "default_popup": "settings.html"
  },
  "options_page": "settings.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "navigation",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "youtube.css",
        "watch-panel.css"
      ],
      "js": [
        "routes.js",
        "navigation.js",
        "platform.js",
        "preferences.js",
        "youtube-controls.js",
        "feed-dates.js",
        "strict-sections.js",
        "strict-mode.js",
        "feed.js",
        "watch-panel.js"
      ],
      "exclude_matches": [
        "https://www.youtube.com/feed/subscriptions?stopit-panel=1"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/feed/subscriptions?stopit-panel=1"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "youtube.css",
        "panel-feed.css"
      ],
      "js": [
        "routes.js",
        "platform.js",
        "preferences.js",
        "feed-dates.js",
        "strict-sections.js",
        "strict-mode.js",
        "panel-feed.js",
        "feed.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "check.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://www.youtube.com; frame-ancestors 'none'; object-src 'none'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
